# Copy this file to n8n/.env. Never commit n8n/.env.
# After confirming an n8n upgrade, replace latest with the tested version.
N8N_VERSION=latest
N8N_PORT=5678

# Local-only setup. GitHub webhooks cannot reach this address.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/

